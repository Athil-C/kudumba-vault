# =====================================================================
# Kudumba Vault — Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# NEVER commit .env with real secrets to version control.
# =====================================================================

# SERVER & HOSTING
PORT="3000"
APP_URL="http://localhost:3000"

# AI SERVICES (Google Gemini)
GEMINI_API_KEY="your-gemini-api-key"

# MONGODB ATLAS (Primary database for user profiles, document metadata, expiry milestones & notification logs)
# Use your MongoDB Atlas connection string. Replace <username>, <password>, and <cluster>.
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/kudumba_vault?retryWrites=true&w=majority&appName=KudumbaVault"

# AUTHENTICATION & SECURITY
# Generate a cryptographically secure 64-byte hex string (e.g. node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET="replace-with-a-cryptographically-secure-random-64-character-secret"
JWT_EXPIRES_IN="7d"

# SUPABASE AUTH & PRIVATE OBJECT STORAGE
# SUPABASE_URL and SUPABASE_ANON_KEY can be exposed safely to browser for Supabase Auth.
# SUPABASE_SERVICE_ROLE_KEY is strictly server-side; NEVER expose to frontend.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_STORAGE_BUCKET="kudumba-vault-documents"

# APPLICATION-LEVEL FIELD ENCRYPTION (AES-256-GCM 32-byte / 64-char hex key)
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_MASTER_KEY="your-32-byte-hex-encryption-key-generate-via-crypto-randomBytes"
CRON_SECRET="your-cryptographically-strong-random-cron-secret"

# GMAIL SMTP & EXPIRY NOTIFICATION SETTINGS
# Requires a Google Account with 2-Step Verification and a 16-character App Password
GMAIL_USER="your-sender-address@gmail.com"
GMAIL_APP_PASSWORD="your-16-char-app-password"
ALERT_DEFAULT_RECIPIENT="your-test-recipient@example.com"

# LEGACY / PRESERVED PRISMA POSTGRESQL (Kept intact for schema reference)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kudumba_vault?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/kudumba_vault?schema=public"

# I18N & PUBLIC CONTACT
VITE_DEFAULT_LOCALE="ml"
VITE_WHATSAPP_SUPPORT_NUMBER="910000000000"

# MESSAGING & STORAGE PROVIDERS (Optional in dev sandbox)
MSG91_AUTH_KEY=""
MSG91_OTP_TEMPLATE_ID=""
S3_BUCKET_NAME="kudumba-vault-private-mumbai"
S3_REGION="ap-south-1"

# RAZORPAY PAYMENT GATEWAY (Optional server-side only; NEVER expose secret to frontend)
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"
RAZORPAY_WEBHOOK_SECRET="your-razorpay-webhook-secret"

# DEVELOPMENT SANDBOX MOCK MODE (Strictly ignored in production; allowed only in development)
ALLOW_MOCK_DB="false"

